# =============================================================================
# Collct — Environment Configuration
# =============================================================================
# All variables are optional and have sensible defaults.
# Copy this file to .env and adjust as needed.

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string. Required for Docker/self-hosted deployments.
# On Vercel, NuxtHub auto-configures this via the Neon integration.
# For local development, start Postgres with: docker-compose up -d db
# Then ensure this points to the local instance (same as db:migrate uses).
DATABASE_URL=postgresql://collct:collct@localhost:5432/collct

# --- Session ------------------------------------------------------------------
# Encryption key for session cookies.
# A default is provided for zero-config deploy, but you should set your own
# for production. Generate one with: openssl rand -hex 32
# NUXT_SESSION_PASSWORD=

# --- Blob Storage -------------------------------------------------------------
# Directory for local blob storage (photos, avatars).
# When set, blobs are stored on disk instead of Vercel Blob.
# Required for self-hosted deployments (not needed on Vercel).
# COLLCT_BLOB_DIR=./data/blob

# --- Registration & Access ----------------------------------------------------
# Controls who can create new accounts.
# "yes" (default): anyone can sign up
# "invite-only":    only users with a valid invite link can register
# "no":             registration disabled, only existing users can log in
# COLLCT_ALLOW_REGISTRATION=yes

# Whether the Public group exists and users are auto-joined on signup.
# "true" (default): Public group created, new users auto-joined
# "false":           no Public group, photos must be posted to private groups only
# COLLCT_PUBLIC_GROUP_ENABLED=true

# --- Instance Branding --------------------------------------------------------
# Display name of this instance (used in emails, page titles, PWA manifest).
# COLLCT_INSTANCE_NAME=Collct

# Short description of this instance (shown in PWA manifest).
# COLLCT_INSTANCE_DESCRIPTION=A friends-first photo sharing app. No algorithm. No tracking. No strangers.

# Contact email for the instance administrator (shown in VAPID push details, legal pages, error emails).
# COLLCT_ADMIN_EMAIL=admin@example.com

# --- Session Management -------------------------------------------------------
# How long a session token is valid before requiring re-login (in seconds).
# Default: 2592000 (30 days)
# COLLCT_SESSION_MAX_AGE=2592000

# Whether session cookies are marked as Secure (HTTPS-only).
# "true" in production, "false" in development (unless explicitly set).
# COLLCT_SESSION_SECURE=true

# SameSite cookie attribute (guards against CSRF).
# "lax" (default), "strict", or "none"
# COLLCT_SESSION_SAME_SITE=lax

# --- Authentication -----------------------------------------------------------
# Whether users must verify their email before logging in.
# Requires email service integration (not yet implemented).
# COLLCT_REQUIRE_EMAIL_VERIFICATION=false

# --- Feature Flags ------------------------------------------------------------
# Whether push notifications are enabled.
# When disabled, POST /api/notifications/subscribe returns 403.
# COLLCT_NOTIFICATIONS_ENABLED=true

# Whether users can comment on photos.
# When disabled, comment endpoints return 403.
# COLLCT_COMMENTS_ENABLED=true

# Whether the PWA caches photos for offline viewing.
# Controls Service Worker caching strategy.
# COLLCT_OFFLINE_MODE_ENABLED=true

# --- Push Notifications (Web) ------------------------------------------------
# VAPID keys for web push notifications.
# Auto-generated on first run and stored in the database.
# Optionally set these to use your own keys instead.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Push Notifications (APNs — iOS native) ----------------------------------
# All optional. If not configured, APNs subscriptions are stored but skipped.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXX.p8
# APNS_BUNDLE_ID=com.collct.app
# APNS_PRODUCTION=false

# --- Push Notifications (FCM — Android native) --------------------------------
# All optional. If not configured, FCM subscriptions are stored but skipped.
# Provide inline JSON or a file path (starts with /).
# FCM_SERVICE_ACCOUNT=./secrets/service-account.json

# --- Moments (BeReal-style daily capture) -------------------------------------
# Whether the Moments feature is enabled instance-wide.
# When enabled, users receive a daily prompt to capture a photo within a random
# window. Per-group opt-in/out is controlled separately.
# COLLCT_MOMENTS_ENABLED=false

# The daily window (in server timezone) during which the random moment occurs.
# Format: HH:mm (24-hour). The actual moment time is randomly chosen within this range.
# COLLCT_MOMENTS_WINDOW_START=18:00
# COLLCT_MOMENTS_WINDOW_END=20:00

# How many seconds users have to capture and post once notified.
# COLLCT_MOMENTS_CAPTURE_DURATION=300

# Whether users can post to all moment groups at once (single toggle).
# Set to false to require explicit per-group selection.
# COLLCT_MOMENTS_ALLOW_POST_TO_ALL=true

# Whether to allow photo library selection as fallback for moment capture.
# When false, moment capture is camera-only on all devices.
# When true, desktop users get a library fallback option.
# COLLCT_MOMENTS_ALLOW_LIBRARY_FALLBACK=false

# Secret token for the moments trigger endpoint (/api/moments/trigger).
# Used by external cron services and Vercel Cron to compute the daily moment time
# and send notifications. Generate one with: openssl rand -hex 32
# Required for the server-side trigger to work. Without it, notifications depend
# on a user opening the app before the window.
# CRON_SECRET=

# --- Third-Party Client Access ------------------------------------------------
# Comma-separated list of origins allowed to make API requests from browsers.
# By default, all origins are allowed (no config needed for one-click deploy).
# Set this to restrict CORS to specific client domains for extra security.
# COLLCT_ALLOWED_ORIGINS=https://collct.domain.app,https://my-client.com

# The origin of the official Collct web app. Used to build authorize URLs.
# Only needed if your client runs on a different domain than the server.
# COLLCT_APP_URL=https://collct.vercel.app
