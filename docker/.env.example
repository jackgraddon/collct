# =============================================================================
# Collct — Docker Production Environment
# =============================================================================
# Copy this file to docker/.env and fill in the values.
#
#   cp docker/.env.example docker/.env
#   nano docker/.env

# ── Required ─────────────────────────────────────────────────────────────────

# Encryption key for session cookies. Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# PostgreSQL password (must match POSTGRES_PASSWORD above)
POSTGRES_PASSWORD=

# Secret token for the moments trigger endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Instance ─────────────────────────────────────────────────────────────────

# COLLCT_INSTANCE_NAME=Collct
# COLLCT_INSTANCE_DESCRIPTION=A friends-first photo sharing app. No algorithm. No tracking. No strangers.
# COLLCT_ADMIN_EMAIL=admin@example.com

# ── Access ───────────────────────────────────────────────────────────────────

# COLLCT_ALLOW_REGISTRATION=yes
# COLLCT_PUBLIC_GROUP_ENABLED=true
# COLLCT_SESSION_SECURE=true
# COLLCT_SESSION_SAME_SITE=lax

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins (leave empty for all)
# COLLCT_ALLOWED_ORIGINS=https://yourdomain.com

# Public URL of the app (used for OAuth authorize URLs)
# COLLCT_APP_URL=https://yourdomain.com

# ── App Port ─────────────────────────────────────────────────────────────────

# APP_PORT=3000

# ── Moments (BeReal-style daily capture) ─────────────────────────────────────

# COLLCT_MOMENTS_ENABLED=false
# COLLCT_MOMENTS_WINDOW_START=18:00
# COLLCT_MOMENTS_WINDOW_END=20:00
# COLLCT_MOMENTS_CAPTURE_DURATION=300

# ── Feature Flags ────────────────────────────────────────────────────────────

# COLLCT_NOTIFICATIONS_ENABLED=true
# COLLCT_COMMENTS_ENABLED=true
# COLLCT_OFFLINE_MODE_ENABLED=true

# ── Push Notifications — Web (VAPID) ─────────────────────────────────────────

# Auto-generated on first run if not set. Optionally provide your own keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
