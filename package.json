{
  "name": "collct",
  "version": "1.1.0",
  "description": "A friends-first social media designed to connect you to your friends, and that's it. No algorithm, no tracking, no strangers.",
  "author": "Jack Graddon <hello@jackgraddon.com>",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackgraddon/collct.git"
  },
  "bugs": {
    "url": "https://github.com/jackgraddon/collct/issues"
  },
  "homepage": "https://github.com/jackgraddon/collct#readme",
  "scripts": {
    "build": "nuxt build",
    "predev": "docker compose -f docker-compose.dev.yml up -d --wait postgres",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "DATABASE_URL=postgresql://collct:collct@localhost:5432/collct drizzle-kit migrate",
    "predb:seed:dev": "docker compose -f docker-compose.dev.yml up -d --wait postgres && pnpm run db:migrate",
    "db:seed:dev": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@nuxthub/core": "^0.10.7",
    "@nuxtjs/seo": "^5.1.3",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@takumi-rs/core": "^1.6.0",
    "@vercel/blob": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.4.6",
    "nuxt-qrcode": "^0.4.10",
    "otpauth": "^9.5.1",
    "postgres": "^3.4.9",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@iconify-json/solar": "^1.2.5",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.2",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.8.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "drizzle-kit": "^0.31.10",
    "nuxt-auth-utils": "^0.5.29",
    "tsx": "^4.19.0",
    "vercel": "^54.6.1"
  }
}
